generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String?  @unique
  username       String
  githubUsername String?
  githubId       String?  @unique
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  userProjects UserProject[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                 String   @id @default(cuid())
  code               String   @unique
  title              String
  category           String
  difficulty         String
  description        String
  estimatedScope     String
  businessContext    String
  role               String
  requirements       String
  constraints        String
  acceptanceCriteria String
  competencies       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userProjects UserProject[]
}

model UserProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  status    String   @default("NOT_STARTED")
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository     Repository?
  mentorSessions MentorSession[]
  assessments    Assessment[]
  proof          Proof?

  @@unique([userId, projectId])
}

model Repository {
  id            String   @id @default(cuid())
  userProjectId String   @unique
  githubId      String?
  name          String
  owner         String
  url           String
  visibility    String?
  defaultBranch String?
  status        String   @default("CONNECTED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProject UserProject          @relation(fields: [userProjectId], references: [id], onDelete: Cascade)
  snapshots   RepositorySnapshot[]
}

model RepositorySnapshot {
  id           String   @id @default(cuid())
  repositoryId String
  commitSha    String
  branch       String
  fetchedAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model MentorSession {
  id            String   @id @default(cuid())
  userProjectId String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProject UserProject     @relation(fields: [userProjectId], references: [id], onDelete: Cascade)
  messages    MentorMessage[]
}

model MentorMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session MentorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Assessment {
  id            String   @id @default(cuid())
  userProjectId String
  status        String   @default("PENDING")
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProject UserProject          @relation(fields: [userProjectId], references: [id], onDelete: Cascade)
  evidence    AssessmentEvidence[]
}

model AssessmentEvidence {
  id           String   @id @default(cuid())
  assessmentId String
  competency   String
  sourceType   String
  sourceRef    String?
  question     String?
  answer       String?
  note         String?
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Proof {
  id              String   @id @default(cuid())
  userProjectId   String   @unique
  result          String
  publicId        String   @unique @default(cuid())
  generatedAt     DateTime @default(now())
  competencies    String
  verifiedThrough String
  createdAt       DateTime @default(now())

  userProject UserProject @relation(fields: [userProjectId], references: [id], onDelete: Cascade)
}
